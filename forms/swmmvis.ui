   </property>
   <property name="toolTip">
    <string>Convert features from a GIS vector layer into SWMM objects — points to nodes or rain gages, polylines to conduits, pumps, orifices, weirs, or outlets — with attribute-column mapping and update/skip handling of existing objects.</string>
   </property>
   <property name="statusTip">
    <string>Import a feature layer as SWMM objects (Tools → Import Feature Layer…)</string>
   </property>
   <property name="menuRole">
    <enum>QAction::NoRole</enum>
   </property>
