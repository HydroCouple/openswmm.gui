        <file alias="irregular_xsect.svg">images/irregular_xsect.svg</file>
        <file alias="modified_baskethandle_xsect.svg">images/modified_baskethandle_xsect.svg</file>
        <file alias="open_rectangular_xsect.svg">images/open_rectangular_xsect.svg</file>
        <file alias="parabolic_xsect.svg">images/parabolic_xsect.svg</file>
        <file alias="power_xsect.svg">images/power_xsect.svg</file>
        <file alias="rectangular_round_xsect.svg">images/rectangular_round_xsect.svg</file>
        <file alias="rectangular_triangular_xsect.svg">images/rectangular_triangular_xsect.svg</file>
        <file alias="rectangular_xsect.svg">images/rectangular_xsect.svg</file>
        <file alias="semi-elliptical_xsect.svg">images/semi-elliptical_xsect.svg</file>
        <file alias="street_xsect.svg">images/street_xsect.svg</file>
