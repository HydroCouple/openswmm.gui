# Optional strict check of the public SDK docs included by docs/Doxyfile.
# The GUI documentation site is built from docs/ with: doxygen Doxyfile
# Run this focused check from the repository root:
#   doxygen docs/sdk/Doxyfile
PROJECT_NAME = "OpenSWMM GUI Extension SDK"
PROJECT_NUMBER = 1.5
OUTPUT_DIRECTORY = build/docs/sdk
INPUT = include/sdk docs/sdk/extensions.dox docs/manual/26_extensions.md examples/extensions/template/extension.cpp examples/extensions/events/extension.cpp examples/extensions/lifecycle/extension.cpp examples/extensions/views/extension.cpp examples/extensions/activity/extension.cpp examples/extensions/values/extension.cpp examples/extensions/values/ValueEventAdapter.hpp examples/extensions/values/ValueEventAdapter.cpp
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.cpp *.dox *.md
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
INHERIT_DOCS = YES
JAVADOC_AUTOBRIEF = YES
ALIASES = "license=\par License^^"
QUIET = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
GENERATE_HTML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
USE_MDFILE_AS_MAINPAGE =
HTML_DYNAMIC_SECTIONS = YES
DISABLE_INDEX = NO
