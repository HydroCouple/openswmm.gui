# Optional strict check of implementation docs included in the main GUI site.
# Run from the repository root: doxygen docs/sdk/Doxyfile.internal
@INCLUDE = docs/sdk/Doxyfile
PROJECT_NAME = "OpenSWMM GUI Extension Implementation"
OUTPUT_DIRECTORY = build/docs/sdk-internal
INPUT += include/plugins/extensionmanager.h \
         include/plugins/extensionsharedribbon.h \
         src/plugins/extensionsharedribbon.cpp \
         include/plugins/guiextensionhost.h \
         include/plugins/extensiontoolbox.h \
         src/plugins/extensiontoolbox.cpp \
         include/plugins/extensiontoolruns.h \
         src/plugins/extensiontoolruns.cpp \
         src/plugins/extensiontoolservices.cpp \
         include/ui/panels/toolboxpanel.h \
         src/ui/panels/toolboxpanel.cpp \
         include/ui/panels/toolrunspanel.h \
         src/ui/panels/toolrunspanel.cpp \
         include/plugins/extensionmodelaccess.h \
         include/plugins/extensiontimeseriesaccess.h \
         src/plugins/extensiontimeseriesaccess.cpp \
         include/plugins/extensionnetwork.h \
         include/plugins/extensionpreferences.h \
         include/plugins/extensionattributes.h \
         include/plugins/extensionevents.h \
         include/plugins/extensionstateregistry.h \
         include/plugins/extensionactivityui.h \
         src/plugins/extensionactivityui.cpp \
         include/plugins/extensionviewaccess.h \
         src/plugins/extensionviewaccess.cpp \
         src/plugins/extensionmodelevents.cpp \
         src/plugins/extensionlayerevents.cpp \
         src/plugins/extensionresultsevents.cpp \
         src/plugins/extensionevents.cpp \
         src/plugins/extensionstateregistry.cpp \
         src/sdk/EventSignalAdapter.cpp \
         src/sdk/ViewSignalAdapter.cpp \
         src/sdk/ActivitySignalAdapter.cpp \
         src/plugins/extensionattributes.cpp \
         src/plugins/extensionmanager.cpp \
         src/plugins/guiextensionhost.cpp \
         src/plugins/extensionmodelaccess.cpp \
         src/plugins/extensionnetwork.cpp \
         src/swmmvisextensions.cpp \
         include/swmmvis.h
# Resolve the application's integration method without including the unrelated main-window API.
EXCLUDE_SYMBOLS += SWMMVis
