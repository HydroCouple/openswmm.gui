[TITLE]
;; Synthetic closed 3% slope for the SWMMVis stand-alone 2D tutorial.
;; Local metre coordinates; no real site or calibrated design parameters.
;; Baseline explicitly uses FLAT/MEAN; compare with VFR/VFR_FACE in a copy.

[OPTIONS]
CRS EPSG:3857
FLOW_UNITS CMS
INFILTRATION HORTON
FLOW_ROUTING DYNWAVE
START_DATE 01/01/2026
START_TIME 00:00:00
REPORT_START_DATE 01/01/2026
REPORT_START_TIME 00:00:00
END_DATE 01/01/2026
END_TIME 06:00:00
REPORT_STEP 0:02:00
WET_STEP 0:00:05
DRY_STEP 0:00:05
ROUTING_STEP 2
THREADS 1

[EVAPORATION]
CONSTANT 0

[RAINGAGES]
;;Name Format Interval SCF Source
GAGE1 INTENSITY 0:05 1.0 TIMESERIES RAIN

[TIMESERIES]
RAIN 0:00 20.0
RAIN 0:05 20.0
RAIN 0:10 20.0
RAIN 0:15 20.0
RAIN 0:20 20.0
RAIN 0:25 20.0
RAIN 0:30 20.0
RAIN 0:35 20.0
RAIN 0:40 20.0
RAIN 0:45 20.0
RAIN 0:50 20.0
RAIN 0:55 20.0
RAIN 1:00 0.0
RAIN 6:00 0.0

[SYMBOLS]
GAGE1 -10 15

[2D_OPTIONS]
INTEGRATOR EXPLICIT
MAX_TIMESTEP 5.0
DRY_DEPTH 0.001
CELL_CLOSURE FLAT
FACE_RECONSTRUCTION MEAN
RAINFALL_MODE SYSTEM
REPORT_2D YES
OUTPUT_FILE vfr_slope.2d.h5

