[TITLE]
Hydrology editor demonstration — synthetic, uncalibrated.
Populated LID, snowpack, groundwater, RTK/IA and initial-loadings editors.
Snowmelt disabled; snowpack definition illustrates the editor only.

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

IGNORE_RAINFALL      NO
IGNORE_SNOWMELT      YES
IGNORE_GROUNDWATER   NO
IGNORE_RDII          NO
IGNORE_ROUTING       NO
IGNORE_QUALITY       NO

START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/03/2020
END_TIME             00:00:00
SWEEP_START          1/1
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          0:15:00
WET_STEP             0:05:00
DRY_STEP             1:00:00
ROUTING_STEP         0:00:20
RULE_STEP            0:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
SURCHARGE_METHOD     EXTRAN
UNSTEADY_FRICTION    NONE
UF_K3                0.015
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Type       Parameters
;;---------- ----------
CONSTANT     0.1000
DRY_ONLY     NO

[RAINGAGES]
;;Name             Format       Intvl    SCF      Source          
;;---------------- ------------ -------- -------- ----------------
RG1              INTENSITY    0:15     1.00     TIMESERIES TS1

[SUBCATCHMENTS]
;;Name             RainGage         Outlet           Area         %%Imperv   Width        %%Slope    CurbLen    Snowpack         RainScale  SnowScale 
;;---------------- ---------------- ---------------- ------------ ---------- ------------ ---------- ---------- ---------------- ---------- ----------
S1               RG1              J1                     5.0000      25.00     500.0000     0.5000     0.0000 SP1

[SUBAREAS]
;;Subcatch         N-Imperv   N-Perv     S-Imperv   S-Perv     %%ZeroImp  RouteTo  PctRouted 
;;---------------- ---------- ---------- ---------- ---------- ---------- -------- ----------
S1                   0.0100     0.1000     0.0500     0.0500      25.00 OUTLET         0.00

[INFILTRATION]
;;Subcatch         Param1     Param2     Param3     Param4     Param5    
;;---------------- ---------- ---------- ---------- ---------- ----------
S1                   3.0000     0.5000     4.0000     7.0000     0.0000 HORTON

[AQUIFERS]
;;Name             Porosity   WiltPoint  FieldCap   Ksat       Kslope     Tslope     ETu        ETs        Seepage    Ebot       Egw        Umc        ETupat          
;;---------------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------------
AQ1              0.5        0.15       0.3        5          10         15         0.35       0          0.002      90         100        0.3        EVAP1           

[GROUNDWATER]
;;Subcatchment     Aquifer          Node             SurfElev   A1         B1         A2         B2         A3         Tw         Hstar     
;;---------------- ---------------- ---------------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------
S1               AQ1              J1               112        0.001      1          0          0          0          0          0         

[GWF]
;;Subcatchment     Type       Expression
S1               LATERAL    0.001*(HGW-10)

[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J1                   100.0000       5.0000       0.0000       0.0000       0.0000

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
O1                    95.0000 FREE         NO      

[CONDUITS]
;;Name             FromNode         ToNode           Length       Roughness    InOffset     OutOffset    InitFlow   MaxFlow   
;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
C1               J1               O1                           400            0.01       0.0000       0.0000     0.0000     0.0000

[XSECTIONS]
;;Link             Shape            Geom1        Geom2        Geom3        Geom4        Barrels 
;;---------------- ---------------- ------------ ------------ ------------ ------------ --------
C1               CIRCULAR         3 0 0 0        1

[REPORT]
;;Keyword          Value
DISABLED             NO
INPUT                NO
CONTINUITY           YES
FLOWSTATS            YES
CONTROLS             NO
AVERAGES             NO
SUBCATCHMENTS        ALL
NODES                ALL
LINKS                ALL

[PATTERNS]
;;Name             Type        
;;---------------- ------------
EVAP1            MONTHLY          1.0000     1.0000     1.0000     1.0000     1.0000     1.0000
EVAP1                            1.0000     1.0000     1.0000     1.0000     1.0000     1.0000

[TIMESERIES]
;;Name             Date/Time            Value       
;;---------------- -------------------- ------------
TS1              01/01/2020   00:00:00     0.000000
TS1              01/01/2020   00:15:00     2.000000
TS1              01/01/2020   00:30:00     4.000000
TS1              01/01/2020   00:45:00     0.000000

[MAP]
DIMENSIONS -100.0000          -100.0000          1100.0000          1100.0000         
Units      None

[COORDINATES]
;;Node           X-Coord            Y-Coord           
;;-------------- ------------------ ------------------
J1               500.0000           500.0000          
O1               500.0000           0.0000            

[Polygons]
;;Subcatchment   X-Coord            Y-Coord           
;;-------------- ------------------ ------------------
S1               0.0000             800.0000          
S1               400.0000           800.0000          
S1               400.0000           1000.0000         
S1               0.0000             1000.0000         

[SYMBOLS]
;;Gage           X-Coord            Y-Coord           
;;-------------- ------------------ ------------------
RG1              0.0000             500.0000          

[LID_CONTROLS]
;;Illustrative bioretention control; lengths in inches except usage geometry.
BC1 BC
BC1 SURFACE 6 0 0.1 1 5
BC1 SOIL 18 0.5 0.3 0.15 0.5 10 3.5
BC1 STORAGE 12 0.75 0.1 0
BC1 DRAIN 0.5 0.5 0 0

[LID_USAGE]
;;Subcatch Control Number Area(ft2) Width(ft) InitSat(%) FromImperv(%) ToPerv
S1 BC1 2 1000 20 0 50 0

[SNOWPACKS]
;;Snowmelt is disabled in this editor demonstration run.
SP1 PLOWABLE 0.001 0.003 32 0.10 0 0 0.5
SP1 IMPERVIOUS 0.001 0.003 32 0.10 0 0 1
SP1 PERVIOUS 0.001 0.003 32 0.10 0 0 1
SP1 REMOVAL 6 0.2 0.3 0.5 0 0

[HYDROGRAPHS]
UH1 RG1
UH1 ALL SHORT 0.055 1.0 2.0 0.08 0.01 0.02
UH1 ALL MEDIUM 0.032 3.5 2.0 0.08 0.01 0.02
UH1 ALL LONG 0.018 14.0 2.0 0.08 0.01 0.02

[RDII]
J1 UH1 5

[RDII_DECAY]
UH1 SHORT 0.15 0.010 0.070 10 0.055 0
UH1 MEDIUM 0.10 0.008 0.037 10 0.055 0
UH1 LONG 0.05 0.005 0.013 10 0.040 0

[POLLUTANTS]
TSS MG/L 0 0 0 0 * 0 0 0

[LANDUSES]
Urban 0 0 0

[COVERAGES]
S1 Urban 100

[LOADINGS]
S1 TSS 1
