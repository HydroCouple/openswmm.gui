[TITLE]
;;Project Title/Notes
Flow divider demo - one subcatchment draining through a WEIR divider
Kinematic-wave routing in US customary units (CFS, feet); a one-hour design storm.
J1 -> D1 (weir divider): non-diverted link C2 -> J2 -> O1; diverted link C3 -> J3 -> O2.

[OPTIONS]
;;Option             Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         0:00:30
RULE_STEP            00:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         12.557
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
;;-------------- ----------------
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
;;-------------- --------- ------ ------ ----------
RG1              INTENSITY 0:15     1.0      TIMESERIES DesignStorm

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen  SnowPack
;;-------------- ---------------- ---------------- -------- -------- -------- -------- -------- ----------------
S1               RG1              J1               10       50       500      1.0      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo    PctRouted
;;-------------- ---------- ---------- ---------- ---------- ---------- ---------- ----------
S1               0.015      0.25       0.06       0.15       25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
;;-------------- ---------- ---------- ---------- ---------- ----------
S1               3.0        0.5        4          7          0

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
;;-------------- ---------- ---------- ---------- ---------- ----------
J1               100        6          0          0          0
J2               95         6          0          0          0
J3               95         6          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
;;-------------- ---------- ---------- ---------------- -------- ----------------
O1               90         FREE                        NO
O2               90         FREE                        NO

[DIVIDERS]
;;Name           Elevation  Diverted Link    Type       Parameters
;;-------------- ---------- ---------------- ---------- ----------
;;WEIR parameters: Min. Flow (CFS)  Max. Depth (ft)  Coefficient, then MaxDepth InitDepth SurDepth Aponded
D1               98         C3               WEIR       0.5        1.0        3.33       6          0          0          0

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
;;-------------- ---------------- ---------------- ---------- ---------- ---------- ---------- ---------- ----------
C1               J1               D1               400        0.013      0          0          0          0
C2               D1               J2               400        0.013      0          0          0          0
C3               D1               J3               400        0.013      0          0          0          0
C4               J2               O1               400        0.013      0          0          0          0
C5               J3               O2               400        0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert
;;-------------- ------------ ---------------- ---------- ---------- ---------- ---------- ----------
C1               CIRCULAR     2                0          0          0          1
C2               CIRCULAR     1.5              0          0          0          1
C3               CIRCULAR     1.5              0          0          0          1
C4               CIRCULAR     1.5              0          0          0          1
C5               CIRCULAR     1.5              0          0          0          1

[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------
;;One-hour design storm, intensity in in/hr at 15-minute steps (1.0 in total)
DesignStorm                 0:00       0.5
DesignStorm                 0:15       2.0
DesignStorm                 0:30       1.0
DesignStorm                 0:45       0.5
DesignStorm                 1:00       0.0

[REPORT]
;;Reporting Options
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[TAGS]

[MAP]
DIMENSIONS -50.000 0.000 950.000 400.000
Units      Feet

[COORDINATES]
;;Node           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
J1               300.000            200.000
J2               700.000            200.000
J3               700.000            50.000
O1               900.000            200.000
O2               900.000            50.000
D1               500.000            200.000

[VERTICES]
;;Link           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
C3               600.000            50.000

[Polygons]
;;Subcatchment   X-Coord            Y-Coord
;;-------------- ------------------ ------------------
S1               0.000              100.000
S1               0.000              300.000
S1               200.000            300.000
S1               200.000            100.000

[SYMBOLS]
;;Gage           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
RG1              50.000             350.000
