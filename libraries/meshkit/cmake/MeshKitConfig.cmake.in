@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(_meshkit_needs_qt FALSE)
foreach(_component IN LISTS MeshKit_FIND_COMPONENTS)
    if(_component MATCHES "_qt$")
        set(_meshkit_needs_qt TRUE)
    endif()
endforeach()
if(@MESHKIT_BUILD_QT@ AND (NOT MeshKit_FIND_COMPONENTS OR _meshkit_needs_qt))
    find_dependency(Qt6 6.5 COMPONENTS Core Gui Concurrent)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MeshKitTargets.cmake")
foreach(_component IN LISTS MeshKit_FIND_COMPONENTS)
    if(TARGET meshkit::${_component})
        set(MeshKit_${_component}_FOUND TRUE)
    else()
        set(MeshKit_${_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(MeshKit)
unset(_meshkit_needs_qt)
unset(_component)
