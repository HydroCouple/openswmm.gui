find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter Development.Module)
Python3_add_library(meshkit_python MODULE WITH_SOABI src/native/python.cpp)
set_target_properties(meshkit_python PROPERTIES OUTPUT_NAME _meshkit AUTOMOC OFF AUTOUIC OFF AUTORCC OFF)
target_link_libraries(meshkit_python PRIVATE meshkit::io)
set(MESHKIT_PYTHON_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/python/meshkit" CACHE PATH "Python module output directory")
set_target_properties(meshkit_python PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${MESHKIT_PYTHON_OUTPUT}" LIBRARY_OUTPUT_DIRECTORY_RELEASE "${MESHKIT_PYTHON_OUTPUT}" RUNTIME_OUTPUT_DIRECTORY "${MESHKIT_PYTHON_OUTPUT}" RUNTIME_OUTPUT_DIRECTORY_RELEASE "${MESHKIT_PYTHON_OUTPUT}")
file(MAKE_DIRECTORY "${MESHKIT_PYTHON_OUTPUT}")
configure_file(python/meshkit/__init__.py "${MESHKIT_PYTHON_OUTPUT}/__init__.py" COPYONLY)
install(TARGETS meshkit_python LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages/meshkit")
install(FILES python/meshkit/__init__.py DESTINATION "${CMAKE_INSTALL_LIBDIR}/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages/meshkit")
