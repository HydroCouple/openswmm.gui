;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
C_ADV            J1               J2                           300           0.013      10.5000      12.2500     0.7500     0.0000
C_OK             J2               J3                           300           0.013      12.5000      11.0000     0.0000     0.0000

[ORIFICES]
;;Name             FromNode         ToNode           Type       Offset     Cd         Gated    CloseTime 
;;---------------- ---------------- ---------------- ---------- ---------- ---------- -------- ----------
OR1              J3               O1               SIDE          11.5000     0.6500 NO           0.0000

[WEIRS]
;;Name             FromNode         ToNode           Type         CrestHt    Cd         Gated    EndCon     EndCoeff   Surcharge 
;;---------------- ---------------- ---------------- ------------ ---------- ---------- -------- ---------- ---------- ----------
W1               J3               O1               TRANSVERSE      12.0000     3.3300 NO           0.0000     0.0000 YES

[OUTLETS]
;;Name             FromNode         ToNode           Offset     Type             Coeff      Expon     
;;---------------- ---------------- ---------------- ---------- ---------------- ---------- ----------
L1               J3               O1                  11.2500 FUNCTIONAL/HEAD          10        0.5 NO

[XSECTIONS]
