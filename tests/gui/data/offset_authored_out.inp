
[TITLE]
;;Project Title/Notes
InpWriter round-trip fixture: authored form must survive Open -> Save
LINK_OFFSETS is ELEVATION, so every offset/crest below is an absolute
elevation that the parser rewrites as a depth above the node invert. C_ADV is
an adverse-slope conduit (J1 invert 10, J2 invert 12) that the parser reverses
under DYNWAVE. Before the fix the writer emitted the parser's depths under an
ELEVATION header and C_ADV with From/To swapped, so a second open clamped the
offsets to zero and the conduit pointed the wrong way in the file.

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         ELEVATION
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

IGNORE_RAINFALL      NO
IGNORE_SNOWMELT      YES
IGNORE_GROUNDWATER   YES
IGNORE_RDII          NO
IGNORE_ROUTING       NO
IGNORE_QUALITY       NO

START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/02/2020
END_TIME             00:00:00
SWEEP_START          1/1
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          0:15:00
WET_STEP             0:05:00
DRY_STEP             1:00:00
ROUTING_STEP         0:00:30
RULE_STEP            0:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
SURCHARGE_METHOD     EXTRAN
UNSTEADY_FRICTION    NONE
UF_K3                0.015
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Type       Parameters
;;---------- ----------
CONSTANT     0.0000
DRY_ONLY     NO

[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J1                    10.0000       5.0000       0.0000       0.0000       0.0000
J2                    12.0000       5.0000       0.0000       0.0000       0.0000
J3                    11.0000       5.0000       0.0000       0.0000       0.0000

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
O1                     8.0000 FREE         NO      

[CONDUITS]
