[TITLE]
;;Project Title/Notes
Object-creation-defaults fixture (US customary). Two junctions and an
outfall so link-add commands have endpoints. See
workplans/OBJECT_CREATION_DEFAULTS_PLAN_2026-08-03.md.

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           01/01/2026
START_TIME           00:00:00
END_DATE             01/02/2026
END_TIME             00:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         30

[JUNCTIONS]
;;Name   Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1       100.0      10.0      0          0         0
J2       98.0       10.0      0          0         0

[OUTFALLS]
;;Name   Elevation  Type  StageData  Gated  RouteTo
O1       95.0       FREE  *          NO     *

[COORDINATES]
;;Node   X-Coord   Y-Coord
J1       0.0       0.0
J2       500.0     0.0
O1       1000.0    0.0

[MAP]
UNITS      FEET
