
[TITLE]
;;Project Title/Notes
Legacy FILE timeseries repro — inflow driven by external .dat file

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

IGNORE_RAINFALL      NO
IGNORE_SNOWMELT      YES
IGNORE_GROUNDWATER   YES
IGNORE_RDII          NO
IGNORE_ROUTING       NO
IGNORE_QUALITY       NO

START_DATE           01/01/2024
START_TIME           00:00:00
REPORT_START_DATE    01/01/2024
REPORT_START_TIME    00:00:00
END_DATE             01/01/2024
END_TIME             06:00:00
SWEEP_START          1/1
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          0:05:00
WET_STEP             0:05:00
DRY_STEP             1:00:00
ROUTING_STEP         0:00:30
RULE_STEP            0:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
SURCHARGE_METHOD     EXTRAN
UNSTEADY_FRICTION    NONE
UF_K3                0.015
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Type       Parameters
;;---------- ----------
CONSTANT     0.0000
DRY_ONLY     NO

[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J1                   100.0000      10.0000       0.0000       0.0000       0.0000

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
O1                    95.0000 FREE         NO      

[CONDUITS]
;;Name             FromNode         ToNode           Length       Roughness    InOffset     OutOffset    InitFlow   MaxFlow   
;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
C1               J1               O1                           400            0.01       0.0000       0.0000     0.0000     0.0000

[XSECTIONS]
;;Link             Shape            Geom1        Geom2        Geom3        Geom4        Barrels 
;;---------------- ---------------- ------------ ------------ ------------ ------------ --------
C1               CIRCULAR         1.5 0 0 0        1

[REPORT]
;;Keyword          Value
DISABLED             NO
INPUT                NO
CONTINUITY           YES
FLOWSTATS            YES
CONTROLS             NO
AVERAGES             NO
SUBCATCHMENTS        ALL
NODES                ALL
LINKS                ALL

[INFLOWS]
;;Node             Constituent      TimeSeries       Type             Mfactor    Sfactor    Baseline   Pattern         
;;---------------- ---------------- ---------------- ---------------- ---------- ---------- ---------- ----------------
J1               FLOW             TS_FILE          FLOW                 1.0000     1.0000     0.0000                 

[TIMESERIES]
;;Name             Date/Time            Value       
;;---------------- -------------------- ------------
TS_FILE          FILE         "inflow_mixed.dat"

[MAP]
DIMENSIONS 0.0000             0.0000             0.0000             0.0000            
Units      None

[COORDINATES]
;;Node           X-Coord            Y-Coord           
;;-------------- ------------------ ------------------
J1               0.0000             0.0000            
O1               0.0000             0.0000            
