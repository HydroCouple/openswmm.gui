;; Fixture for tests/unit/test_inlet_junction_layer.cpp
;;
;; The minimum model an inlet junction needs:
;;   J1 --C1(STREET)--> J2      the street reach that gets split
;;   SEWER                       the capture (underdrain) node
;;   ST1                         the street section C1 references
;;   GRATE1                      the inlet design placed at the split
;;
;; Kept deliberately small so a split → fuse round trip is easy to eyeball
;; in the .inp the test writes to tests/output/inlets/.

[TITLE]
Inlet junction round-trip fixture

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2026
END_DATE             01/01/2026
REPORT_STEP          00:05:00
ROUTING_STEP         0:00:05

[JUNCTIONS]
;;Name  Elev   MaxDepth  InitDepth  SurDepth  Aponded
J1      100.0  1.0       0          0         0
J2       99.0  1.0       0          0         0
SEWER    90.0  6.0       0          0         0

[OUTFALLS]
;;Name  Elev   Type   Stage  Gated
OUT1     88.0  FREE          NO

[CONDUITS]
;;Name  From   To     Length  Roughness  InOffset  OutOffset
C1      J1     J2     400.0   0.016      0         0
D1      SEWER  OUT1   200.0   0.013      0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      STREET    ST1    0      0      0      1
D1      CIRCULAR  1.5    0      0      0      1

[STREETS]
;;Name  Tcrown  Hcurb  Sx  nRoad  a  W  Sides  Tback  Sback  nBack
ST1     20.0    0.5    4   0.016  0  0  1      0      0      0

[INLETS]
;;Name   Type   Params
GRATE1   GRATE  2.0  2.0  P_BAR-50

[COORDINATES]
;;Node  X       Y
J1        0.0     0.0
J2      400.0     0.0
SEWER   200.0  -100.0
OUT1    400.0  -100.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
