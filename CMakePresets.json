{
    "version": 3,
    "configurePresets": [
        {
            "name": "default-debug",
            "generator": "Ninja", 
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "Windows",
            "inherits": "default",
            "description": "Windows Release build (MSVC, Ninja — requires cl.exe/link.exe on PATH via the MSVC dev environment). Qt located via the QT_ROOT_DIR env var (e.g. an MSVC 64-bit kit); override with -DCMAKE_PREFIX_PATH. Prebuilt engine expected at ../openswmm.engine/install/Windows.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /O2 /GL /fp:precise /W4",
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /GR /O2 /GL /fp:precise /W4",
                "CMAKE_EXE_LINKER_FLAGS": "/LTCG /OPT:REF /OPT:ICF",
                "CMAKE_SHARED_LINKER_FLAGS": "/LTCG /OPT:REF /OPT:ICF",
                "CMAKE_MODULE_LINKER_FLAGS": "/LTCG /OPT:REF /OPT:ICF",
                "CMAKE_STATIC_LINKER_FLAGS": "/LTCG",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_C_FLAGS_RELEASE": "/O2 /GL /fp:precise /W4",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2 /GL /fp:precise /W4",
                "CMAKE_C_FLAGS_DEBUG": "/Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_CXX_FLAGS_DEBUG": "/Zi /Od /DDEBUG /W4 /fp:precise"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Windows-debug",
            "inherits": "default-debug",
            "description": "Windows Debug build (MSVC, Ninja — requires cl.exe/link.exe on PATH via the MSVC dev environment). Qt located via the QT_ROOT_DIR env var (e.g. an MSVC 64-bit kit); override with -DCMAKE_PREFIX_PATH.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /GR /Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_EXE_LINKER_FLAGS": "/DEBUG",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_C_FLAGS_DEBUG": "/Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_CXX_FLAGS_DEBUG": "/Zi /Od /DDEBUG /W4 /fp:precise"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Linux",
            "inherits": "default",
            "description": "Linux build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "-O2 -flto -fdata-sections -ffunction-sections -fipa-icf -fno-fast-math -Wall -Wextra -ffloat-store -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O2 -flto -fdata-sections -ffunction-sections -fipa-icf -fno-fast-math -Wall -Wextra -ffloat-store -fvisibility=hidden",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections -flto",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -flto -fdata-sections -ffunction-sections -fipa-icf -fno-fast-math -Wall -Wextra -ffloat-store",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -flto -fdata-sections -ffunction-sections -fipa-icf -fno-fast-math -Wall -Wextra -ffloat-store",
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Linux-debug",
            "inherits": "default-debug",
            "description": "Linux build for debugging using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store -fvisibility=hidden",
                "CMAKE_EXE_LINKER_FLAGS": "-g",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Darwin",
            "inherits": "default",
            "description": "macOS build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/darwin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "-O2 -flto -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O2 -flto -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra -fvisibility=hidden",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl, -flto",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -flto -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -flto -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra",
                "CMAKE_SHARED_LINKER_FLAGS": "-twolevel_namespace",
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "Darwin-debug",
            "inherits": "default-debug",
            "description": "macOS build for debugging using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/darwin-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math -ffloat-store -fvisibility=hidden",
                "CMAKE_EXE_LINKER_FLAGS": "-g",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_SHARED_LINKER_FLAGS": "-twolevel_namespace",
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "hidden": true,
            "configurePreset": "default"
        },
        {
            "name": "default-debug",
            "hidden": true,
            "configurePreset": "default-debug"
        },
        {
            "name": "Windows",
            "configurePreset": "Windows",
            "targets": [
                "package"
            ]
        },
        {
            "name": "Windows-debug",
            "configurePreset": "Windows-debug",
            "targets": [
                "package"
            ]
        },
        {
            "name": "Linux",
            "configurePreset": "Linux",
            "targets": [
                "package"
            ]
        },
        {
            "name": "Linux-debug",
            "configurePreset": "Linux-debug",
            "targets": [
                "package"
            ]
        },
        {
            "name": "Darwin",
            "configurePreset": "Darwin",
            "targets": [
                "package"
            ]
        },
        {
            "name": "Darwin-debug",
            "configurePreset": "Darwin-debug",
            "targets": [
                "package"
            ]
        }
    ]
}