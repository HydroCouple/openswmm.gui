[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J_P00                  0.4000       0.6000       0.0000       0.0000       0.0000
J_P01                  0.4000       0.6000       0.0000       0.0000       0.0000
J_P02                  0.4000       0.6000       0.0000       0.0000       0.0000

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
J_P03                     0.4 FREE         NO      

[CONDUITS]
;;Name             FromNode         ToNode           Length       Roughness    InOffset     OutOffset    InitFlow   MaxFlow   
;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
C_P00            J_P00            J_P01                         10           0.013            0            0          0          0
C_P01            J_P01            J_P02                         40           0.013            0            0          0          0
C_P02            J_P02            J_P03                         10           0.013            0            0          0          0

[XSECTIONS]
