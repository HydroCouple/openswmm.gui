@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 @Qt6_VERSION_MAJOR@.@Qt6_VERSION_MINOR@ COMPONENTS Core Gui Widgets Network)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSWMMVisSdkTargets.cmake")
set(OpenSWMMVisSdk_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/sdk-manifest.json")
set_and_check(OpenSWMMVisSdk_EVENT_ADAPTER_SOURCE
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/openswmmvis-sdk/qt/EventSignalAdapter.cpp")
set_and_check(OpenSWMMVisSdk_EVENT_ADAPTER_HEADER
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/openswmmvis/sdk/qt/EventSignalAdapter.hpp")
set_and_check(OpenSWMMVisSdk_VIEW_ADAPTER_SOURCE
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/openswmmvis-sdk/qt/ViewSignalAdapter.cpp")
set_and_check(OpenSWMMVisSdk_VIEW_ADAPTER_HEADER
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/openswmmvis/sdk/qt/ViewSignalAdapter.hpp")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSWMMVisExtension.cmake")
check_required_components(OpenSWMMVisSdk)
